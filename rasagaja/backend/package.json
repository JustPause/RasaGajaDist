{
  "name": "backend",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "TOKEN_PATH=~/.secret/token.json CREDENTIALS_PATH=~/.secret/client_secret.json node server.js",
    "devstart": "TOKEN_PATH=\"$HOME/.secret/token.json\" CREDENTIALS_PATH=\"$HOME/.secret/client_secret.json\" nodemon server.js",
    "test": "TOKEN_PATH=\"$HOME/.secret/token.json\" CREDENTIALS_PATH=\"$HOME/.secret/client_secret.json\" node --test unit/index.test.js  "
  },
  "dependencies": {
    "@google-cloud/local-auth": "^2.1.0",
    "express": "^4.21.2",
    "googleapis": "^171.4.0",
    "mammoth": "^1.12.0",
    "officeparser": "^6.0.7",
    "supertest": "^7.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.1",
    "@types/node": "^25.3.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "nodemon": "^3.1.10"
  }
}
